# Supabase Configuration
# Pro produkci / skutečné uložení vyplňte URL a service_role secret key (nikdy ne commitovat skutečné hodnoty!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key

# App Configuration
APP_ORIGIN=http://localhost:3000
DATASET_VERSION=2026-10-11
ANALYTICS_SESSION_SECRET=local-dev-analytics-secret-at-least-32-chars-long
RATE_LIMIT_SECRET=local-dev-rate-limit-secret-key-32-chars

# Volitelné: E-mailová infrastruktura (P1)
# RESEND_API_KEY=re_123456789
# EMAIL_FROM=prehled@vasedomena.cz
