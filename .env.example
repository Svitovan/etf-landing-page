# Supabase Configuration
# Získejte v Supabase Dashboard: Project Settings -> API Keys
# POZOR: Pro backend route handlers (zápis kontaktů a analytiky s RLS) je vyžadován Secret key (sb_secret_... nebo service_role JWT), nikoliv publishable key!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Volitelné: Publishable / anon key (sb_publishable_... nebo anon JWT)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here

# App Configuration
APP_ORIGIN=http://localhost:3000
DATASET_VERSION=2026-10-11
ANALYTICS_SESSION_SECRET=local-dev-analytics-secret-at-least-32-chars-long
RATE_LIMIT_SECRET=local-dev-rate-limit-secret-key-32-chars

# Volitelné: E-mailová infrastruktura (P1)
# RESEND_API_KEY=<set a real key locally only if P1 email delivery is implemented>
# EMAIL_FROM=prehled@vasedomena.cz
