{
  "name": "etf-prehled",
  "version": "1.0.0",
  "private": true,
  "description": "Mobilní landing page se srovnáním ETF pro českého investora",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --ext .ts,.tsx,.mjs --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "tsx scripts/validate-data.ts",
    "check:supabase": "tsx --env-file=.env scripts/check-supabase.ts",
    "report:funnel": "tsx --env-file=.env scripts/funnel-report.ts",
    "analytics:mark-test": "tsx --env-file=.env scripts/mark-test-traffic.ts",
    "cleanup:data": "tsx --env-file=.env scripts/cleanup-data.ts",
    "audit:production": "npm audit --omit=dev --audit-level=low",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "check:secret-exposure": "node scripts/check-secret-exposure.mjs"
  },
  "engines": { "node": "24.x" },
  "overrides": { "postcss": "8.5.30" },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "15.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "4.1.11"
  }
}
